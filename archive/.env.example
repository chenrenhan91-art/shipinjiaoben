# ==================== LLM 配置（阿里云百炼）====================
# API Key：https://bailian.console.aliyun.com → 右上角头像 → API-Key 管理
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 百炼 OpenAI 兼容接口（中国内地版）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 首选模型（免费额度耗尽时按 LLM_FALLBACK_MODELS 顺序自动切换）
LLM_MODEL=qwen3.6-plus
# 免费额度切换链：qwen3.6-plus → qwen-plus → qwen3.6-flash → qwen-turbo
LLM_FALLBACK_MODELS=qwen3.6-plus,qwen-plus,qwen3.6-flash,qwen-turbo

# ==================== 推送配置 ====================
# 飞书机器人 Webhook（在飞书群添加机器人后获取）
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# 企业微信机器人 Webhook（可选）
WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# ==================== 运行模式 ====================
# 1 = 热点驱动模式（自动抓取热点+爆款洗稿）
# 2 = 达人适配模式（爆款适配特定达人风格）
AGENT_MODE=1

# ==================== 达人信息（模式2必填）====================
INFLUENCER_NAME=财经博主名称
INFLUENCER_STYLE=幽默犀利，擅长用大白话讲复杂的金融逻辑
INFLUENCER_DOMAIN=财经

# ==================== 爆款判定阈值（可调整）====================
DOUYIN_LIKE_THRESHOLD=100000
XIAOHONGSHU_LIKE_THRESHOLD=10000
SHIPINHAO_LIKE_THRESHOLD=50000

# ==================== 输出配置 ====================
# 每个选题生成的脚本数量
SCRIPTS_PER_TOPIC=3
# 每条脚本生成的开头钩子变体数量
HOOKS_PER_SCRIPT=3
