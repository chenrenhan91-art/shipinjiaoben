# ==================== LLM 配置 ====================
# OpenAI 兼容接口，支持 OpenAI / DeepSeek / Moonshot / 本地 Ollama 等
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ==================== 推送配置 ====================
# 飞书机器人 Webhook（在飞书群添加机器人后获取）
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# 企业微信机器人 Webhook（可选）
WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# ==================== 运行模式 ====================
# 1 = 热点驱动模式（自动抓取热点+爆款洗稿）
# 2 = 达人适配模式（爆款适配特定达人风格）
AGENT_MODE=1

# ==================== 达人信息（模式2必填）====================
INFLUENCER_NAME=财经博主名称
INFLUENCER_STYLE=幽默犀利，擅长用大白话讲复杂的金融逻辑
INFLUENCER_DOMAIN=财经

# ==================== 爆款判定阈值（可调整）====================
DOUYIN_LIKE_THRESHOLD=100000
XIAOHONGSHU_LIKE_THRESHOLD=10000
SHIPINHAO_LIKE_THRESHOLD=50000

# ==================== 输出配置 ====================
# 每个选题生成的脚本数量
SCRIPTS_PER_TOPIC=3
# 每条脚本生成的开头钩子变体数量
HOOKS_PER_SCRIPT=3
